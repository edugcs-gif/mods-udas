    "main": ["com.edugcs.batraquizar.Batraquizar"],
    "client": ["com.edugcs.batraquizar.client.BatraquizarClient"]
  },
  "mixins": ["batraquizar.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
